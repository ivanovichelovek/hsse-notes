#defn(title: "момент импульса и момент силы")[
  $ arrow(L) = arrow(r) times arrow(p), quad arrow(M) = arrow(r) times arrow(F) $
  $ (d arrow(L))/(d t) = arrow(M) $
]

Сила тяготения центральная ($arrow(F) parallel arrow(r)$), поэтому

#key[
  $ arrow(M)_"грав" = 0 quad => quad arrow(L) = "const" $
  #v(0.3em)
  #text(size: 0.85em, style: "italic", fill: muted)[закон сохранения момента импульса (ЗСМИ)]
