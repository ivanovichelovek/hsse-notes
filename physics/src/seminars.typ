    // --- 1) момент t ---
    content((-0.8, 0.4), [1)], anchor: "east")
    rect((0, 0), (0.3, 0.8), stroke: 0.8pt + ink)
    blk(0.3, 0, 2.8, 0.8, $m(t)$)
    vel(2.95, 0.4, 3.9, $v(t)$)
    content((5.0, 0.4), text(size: 0.9em, style: "italic")[момент $t$], anchor: "west")

