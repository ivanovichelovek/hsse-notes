    line((-1.0, y + 0.4), (-1.9, y + 0.4), stroke: 0.7pt + ink, mark: (end: ">", scale: 0.7))
    content((-1.45, y + 0.7), text(size: 0.9em, $u$))
    blk(0.3, y, 2.8, y + 0.8, $m - d m$)
    vel(2.95, y + 0.4, 3.9, $v + d v$)
    content((5.0, y + 0.4), text(size: 0.9em, style: "italic")[момент $t + d t$], anchor: "west")

    // ось
    line((-2.0, y - 0.8), (4.6, y - 0.8), stroke: 0.5pt + muted, mark: (end: ">", scale: 0.6))
