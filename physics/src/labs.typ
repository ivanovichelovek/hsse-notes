  [*Сумма баллов за семестр*], [*Менее 26*], [*От 26 до 45*], [*От 46 до 75*], [*Более 75*],
  [*Оценка*], [неуд], [уд], [хор], [отл],
)]

#block(breakable: false)[#table(
